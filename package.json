{
  "name": "versatiles-frontend",
  "version": "3.14.0",
  "private": true,
  "description": "",
  "scripts": {
    "build": "tsx --env-file-if-exists=.env src/build.ts",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e && npm run test:e2e:browser",
    "dev": "tsx --env-file-if-exists=.env src/dev.ts",
    "doc-graph": "vrt deps-graph | vrt doc-insert README.md '### Dependency Graph'",
    "doc": "npm run doc-graph",
    "format": "prettier --log-level warn --write .",
    "format:check": "prettier --log-level warn --check .",
    "lint": "eslint . --color",
    "prepack": "npm run build",
    "prepare": "husky",
    "release": "vrt release-npm",
    "test-coverage": "vitest run --coverage",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:e2e:browser": "npx playwright test --config e2e/playwright/playwright.config.ts",
    "test:e2e:browser:update": "npx playwright test --config e2e/playwright/playwright.config.ts --update-snapshots",
    "test:e2e:browser:update-linux": "./scripts/update-snapshots-linux.sh",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/playwright/tsconfig.json",
    "upgrade": "vrt deps-upgrade"
  },
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "author": "Michael Kreil <versatiles@michael-kreil.de>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mapbox/mapbox-gl-rtl-text": "^0.4.0",
    "@maplibre/maplibre-gl-geocoder": "^1.9.4",
    "@maplibre/maplibre-gl-inspect": "^1.9.0",
    "@playwright/test": "^1.63.0",
    "@types/escape-html": "^1.0.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/tar-stream": "^3.1.4",
    "@types/unzipper": "^0.10.11",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@versatiles/release-tool": "^2.15.0",
    "@versatiles/style": "^6.0.0",
    "@versatiles/svg-renderer": "^1.2.0",
    "@vitest/coverage-v8": "^5.0.1",
    "arg": "^5.0.2",
    "dotenv": "^18.0.1",
    "esbuild": "^0.28.2",
    "escape-html": "^1.0.3",
    "eslint": "^10.11.0",
    "express": "^5.2.1",
    "husky": "^9.1.7",
    "ignore": "^7.0.9",
    "maplibre-gl": "^6.10.0",
    "maplibre-versatiles-styler": "^2.0.0",
    "mrmime": "^2.0.1",
    "prettier": "^3.9.8",
    "supports-color": "^11.0.0",
    "tar": "^7.5.22",
    "tar-stream": "^3.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "unzipper": "^0.12.5",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
