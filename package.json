{
  "name": "versatiles-frontend",
  "version": "3.13.1",
  "private": true,
  "description": "",
  "bin": {
    "versatiles-frontend": "src/index.ts"
  },
  "scripts": {
    "build": "tsx --env-file-if-exists=.env src/build.ts",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e && npm run test:e2e:browser",
    "dev": "tsx --env-file-if-exists=.env src/dev.ts",
    "doc-graph": "vrt deps-graph | vrt doc-insert README.md '### Dependency Graph'",
    "doc": "npm run doc-graph",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --color",
    "prepack": "npm run build",
    "prepare": "husky",
    "release": "vrt release-npm",
    "test-coverage": "vitest run --coverage",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:e2e:browser": "npx playwright test --config e2e/playwright/playwright.config.ts",
    "test:e2e:browser:update": "npx playwright test --config e2e/playwright/playwright.config.ts --update-snapshots",
    "test:e2e:browser:update-linux": "docker run --rm -v .:/work -v /work/node_modules -w /work mcr.microsoft.com/playwright:v$(node -p \"require('./package-lock.json').packages['node_modules/@playwright/test'].version\")-noble bash -c 'npm ci && npx playwright test --config e2e/playwright/playwright.config.ts --update-snapshots'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/playwright/tsconfig.json",
    "upgrade": "vrt deps-upgrade"
  },
  "type": "module",
  "author": "Michael Kreil <versatiles@michael-kreil.de>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mapbox/mapbox-gl-rtl-text": "^0.4.0",
    "@maplibre/maplibre-gl-geocoder": "^1.9.4",
    "@maplibre/maplibre-gl-inspect": "^1.8.2",
    "@playwright/test": "^1.62.1",
    "@types/escape-html": "^1.0.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/tar-stream": "^3.1.4",
    "@types/unzipper": "^0.10.11",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@versatiles/release-tool": "^2.9.0",
    "@versatiles/style": "^5.13.1",
    "@versatiles/svg-renderer": "^1.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "arg": "^5.0.2",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "escape-html": "^1.0.3",
    "eslint": "^10.8.1",
    "express": "^5.2.1",
    "husky": "^9.1.7",
    "ignore": "^7.0.6",
    "maplibre-gl": "^6.3.0",
    "maplibre-versatiles-styler": "^1.3.2",
    "mrmime": "^2.0.1",
    "prettier": "^3.9.6",
    "supports-color": "^11.0.0",
    "tar": "^7.5.22",
    "tar-stream": "^3.2.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "unzipper": "^0.12.5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
